<Window x:Class="DockerDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DockerDashboard.Converters"
        xmlns:models="clr-namespace:DockerDashboard.Models"
        mc:Ignorable="d"
        Title="Docker Dashboard" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
    <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
    <converters:StatusToIconConverter x:Key="StatusToIconConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BindingProxy x:Key="Proxy" Data="{Binding}" />
    <converters:FrontendStatusToColorConverter x:Key="FrontendStatusToColorConverter" />

    <!-- 前端專案列（內部/外部兩組共用） -->
    <DataTemplate x:Key="FrontendProjectTemplate">
        <materialDesign:Card Margin="4" Padding="8">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="●" FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding DisplayStatus, Converter={StaticResource FrontendStatusToColorConverter}}"
                               AutomationProperties.Name="{Binding StatusText}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="4,0,0,0"
                               Foreground="Gray" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BranchDisplay}"
                               Foreground="#1E88E5" FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{Binding FolderName}" FontSize="11" Foreground="Gray"
                           Margin="18,2,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="啟動" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsDevStopped, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding Data.StartFrontendCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="停止" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsDevRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding Data.StopFrontendCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="install" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding Data.RunInstallCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="vitest" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding Data.RunTestCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="e2e" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="{Binding IsNotBusy}"
                            Command="{Binding Data.RunE2eCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="取消" Height="26" Padding="8,0" Foreground="#F44336"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding Data.CancelOneShotCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="編輯" Height="26" Padding="8,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="{Binding IsIdle}"
                            ToolTip="編輯名稱、群組與指令（執行中需先停止）"
                            Command="{Binding Data.EditFrontendProjectCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                    <Button Content="移除" Height="26" Padding="8,0" Foreground="Gray"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding Data.RemoveFrontendProjectCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
        <TabItem Header="後端 (Docker)">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具列 -->
        <materialDesign:Card Grid.Row="0" Margin="8,8,8,4" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ImportFolderCommand}"
                        ToolTip="匯入專案資料夾">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderPlus" VerticalAlignment="Center" />
                        <TextBlock Text="匯入資料夾" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="8,0" />

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding AllUpCommand}"
                        IsEnabled="{Binding CanAllUp}"
                        Foreground="#4CAF50"
                        ToolTip="Fast Dev 啟動（host build + 掛最新 dll、跑最新 code、改 .cs 約 5 秒生效，需 host .NET SDK）。左側選了 service 只起該 service、選了專案起該專案，沒選才起全部。">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Flash" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StartButtonText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding AllDownCommand}"
                        IsEnabled="{Binding CanAllDown}"
                        Foreground="#F44336"
                        ToolTip="停止所有服務">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StopCircle" VerticalAlignment="Center" />
                        <TextBlock Text="全部停止" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="8,0" />

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ToggleFastDevAutoReloadCommand}"
                        ToolTip="自動熱重載開關：Fast Dev 中改 .cs 是否自動 build+重啟（關掉可攢一批改動再手動重載）">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="Fire" />
                                    <Setter Property="Foreground" Value="Gray" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FastDevAutoReloadEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="#FF5722" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="自動熱重載" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding ManualReloadCommand}"
                        ToolTip="手動重載：立刻 host build 並重啟有變動的 Fast Dev 服務（自動關閉時用）">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Reload" VerticalAlignment="Center" />
                        <TextBlock Text="手動重載" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="8,0" />

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding RescanProjectsCommand}"
                        ToolTip="重新掃描所有資料夾">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                        <TextBlock Text="重新掃描" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="8,0" />

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding OpenRepairWindowCommand}"
                        Foreground="#FF9800"
                        ToolTip="修復 Docker（清除損毀 image/volume）">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Wrench" VerticalAlignment="Center" />
                        <TextBlock Text="修復" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="開啟設定">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" VerticalAlignment="Center" />
                        <TextBlock Text="設定" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="8,0" />

                <!-- 發現新版本後顯示（HasUpdate = true） -->
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding CanInstallUpdate}"
                        Foreground="#4CAF50"
                        ToolTip="點擊下載並安裝更新，完成後自動重啟應用程式"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownload" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateStatusText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 操作中指示器 + 取消按鈕 -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Visibility="{Binding IsOperating, Converter={StaticResource BoolToVisibilityConverter}}"
                             Width="20" Height="20" Margin="12,0,0,0" />

                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding CancelOperationCommand}"
                        IsEnabled="{Binding CanCancelOperation}"
                        Visibility="{Binding IsOperating, Converter={StaticResource BoolToVisibilityConverter}}"
                        Foreground="#F44336"
                        Margin="4,0,0,0"
                        ToolTip="取消當前操作（中止並 kill docker 子進程）">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" VerticalAlignment="Center" />
                        <TextBlock Text="取消" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>

        <!-- 主要內容區 -->
        <Grid Grid.Row="1" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側：專案樹 -->
            <materialDesign:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="專案與服務" 
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="12,8" />

                    <TreeView Grid.Row="1" 
                              ItemsSource="{Binding Projects}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.Resources>
                            <!-- 專案層級 -->
                            <HierarchicalDataTemplate DataType="{x:Type models:DockerProject}"
                                                      ItemsSource="{Binding ComposeFiles}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <materialDesign:PackIcon Kind="Folder" Foreground="#FFC107" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <!-- Git 分支 chip -->
                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsGitRepo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SourceBranch" Width="12" Height="12" 
                                                                     Foreground="#1565C0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentBranch}" Margin="4,0,0,0"
                                                       FontSize="11" Foreground="#1565C0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Dirty 指示 -->
                                    <Ellipse Width="8" Height="8" Fill="#FF9800" Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             ToolTip="有未提交的變更"
                                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="切換分支"
                                                      Command="{Binding Data.SwitchBranchCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding IsGitRepo}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="SourceBranch" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="重新整理 Git 狀態"
                                                      Command="{Binding Data.RefreshGitStatusCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding IsGitRepo}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Refresh" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="啟動（快速）"
                                                      Command="{Binding Data.ProjectUpCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      Visibility="{Binding Data.ShowClassicControls, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="啟動此專案全部服務，不重建 image">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Play" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="停止"
                                                      Command="{Binding Data.ProjectDownCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      ToolTip="停止此專案全部服務">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Stop" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Fast Dev All（整包熱重啟）"
                                                      Command="{Binding Data.ToggleProjectFastDevCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      ToolTip="整個專案進 host-build dev 模式：改 C# 約 5 秒生效、不重建 image（需 host 端 .NET SDK）">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FlashOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="移除專案"
                                                      Command="{Binding Data.RemoveProjectCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRemoveProject, Source={StaticResource Proxy}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Delete" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- Compose 檔案層級（操作與專案節點重複，故不另設右鍵選單；起停走專案節點或上方啟動鈕） -->
                            <HierarchicalDataTemplate DataType="{x:Type models:ComposeFile}"
                                                      ItemsSource="{Binding Services}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <materialDesign:PackIcon Kind="Docker" Foreground="#2196F3" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- 服務層級 -->
                            <DataTemplate DataType="{x:Type models:DockerService}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Image}" Margin="8,0,0,0"
                                               Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="啟動"
                                                      Command="{Binding Data.StartServiceCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      Visibility="{Binding Data.ShowClassicControls, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Play" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="停止"
                                                      Command="{Binding Data.StopServiceCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Stop" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="重啟（快速）"
                                                      Command="{Binding Data.RestartServiceCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      Visibility="{Binding Data.ShowClassicControls, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="只重啟 process，不重建 image">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Restart" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="套用最新 code（改了 C#）"
                                                      Command="{Binding Data.ApplyLatestCodeServiceCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      ToolTip="改了 C# 用這個：host build + 熱重載，約 5 秒；服務沒在 Fast Dev 會自動進入（需 .NET SDK）">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon>
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="FlashOutline" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFastDev}" Value="True">
                                                                        <Setter Property="Kind" Value="Flash" />
                                                                        <Setter Property="Foreground" Value="Orange" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="完整重建（改了 Dockerfile/相依）"
                                                      Command="{Binding Data.RebuildRestartServiceCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding Data.CanRebuild, Source={StaticResource Proxy}}"
                                                      Visibility="{Binding Data.ShowClassicControls, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      ToolTip="改了 Dockerfile 或 NuGet 相依才用：重新 build image（分鐘級）；服務在 Fast Dev 中會離開、換回正式 image">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Hammer" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="查看日誌"
                                                      Command="{Binding Data.ViewLogsCommand, Source={StaticResource Proxy}}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Text" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" />

            <!-- 右側：詳細 + 日誌 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 容器詳細資訊 -->
                <materialDesign:Card Grid.Row="0" Margin="0,0,0,4" Padding="12"
                                     Visibility="{Binding SelectedService, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedService.Name}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                                <TextBlock Text="{Binding SelectedService.Status, Converter={StaticResource StatusToIconConverter}}"
                                           Foreground="{Binding SelectedService.Status, Converter={StaticResource StatusToColorConverter}}"
                                           FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Image:" Foreground="Gray" />
                                <TextBlock Text="{Binding SelectedService.Image}" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Ports:" Foreground="Gray" />
                                <TextBlock Margin="6,0,0,0" Foreground="#64B5F6">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding SelectedService.Ports, Mode=OneWay}" />
                                    </TextBlock.Inlines>
                                </TextBlock>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="🔗 開啟" FontSize="11" Height="22" Padding="4,0"
                                        Margin="8,0,0,0"
                                        Click="OpenPort_Click"
                                        Visibility="{Binding SelectedService.IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding StartServiceCommand}"
                                    CommandParameter="{Binding SelectedService}"
                                    IsEnabled="{Binding SelectedService.IsStopped}"
                                    Visibility="{Binding ShowClassicControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="啟動" Foreground="#4CAF50">
                                <materialDesign:PackIcon Kind="Play" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding StopServiceCommand}"
                                    CommandParameter="{Binding SelectedService}"
                                    IsEnabled="{Binding SelectedService.IsRunning}"
                                    ToolTip="停止" Foreground="#F44336">
                                <materialDesign:PackIcon Kind="Stop" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RestartServiceCommand}"
                                    CommandParameter="{Binding SelectedService}"
                                    IsEnabled="{Binding SelectedService.IsRunning}"
                                    Visibility="{Binding ShowClassicControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="重啟（快速，不重建 image）" Foreground="#FF9800">
                                <materialDesign:PackIcon Kind="Restart" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding ApplyLatestCodeServiceCommand}"
                                    CommandParameter="{Binding SelectedService}"
                                    ToolTip="套用最新 code（改了 C#）：host build + 熱重載，約 5 秒；沒在 Fast Dev 會自動進入">
                                <materialDesign:PackIcon>
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="FlashOutline" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedService.IsFastDev}" Value="True">
                                                    <Setter Property="Kind" Value="Flash" />
                                                    <Setter Property="Foreground" Value="Orange" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RebuildRestartServiceCommand}"
                                    CommandParameter="{Binding SelectedService}"
                                    IsEnabled="{Binding SelectedService.IsRunning}"
                                    Visibility="{Binding ShowClassicControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="完整重建（改了 Dockerfile/相依）：重新 build image；在 Fast Dev 中會離開、換回正式 image" Foreground="#9C27B0">
                                <materialDesign:PackIcon Kind="Hammer" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 日誌面板 -->
                <materialDesign:Card Grid.Row="1" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="8,6">
                            <TextBlock Text="即時日誌" DockPanel.Dock="Left"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBox Width="160" Margin="0,0,8,0"
                                         materialDesign:HintAssist.Hint="搜尋日誌..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding BackendLog.Filter, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         VerticalAlignment="Center" FontSize="12"
                                         Height="28" Padding="4,2" />
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding StopLogsCommand}" ToolTip="停止串流"
                                        Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding ExportLogsCommand}" ToolTip="匯出日誌"
                                        Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                        Command="{Binding ClearLogsCommand}" ToolTip="清除日誌"
                                        Width="28" Height="28">
                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding BackendLog.View}"
                                 SelectionMode="Extended"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="複製選取行"
                                              Command="{Binding CopySelectedLogsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="ContentCopy" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="複製全部日誌"
                                              Command="{Binding CopyAllLogsCommand}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="SelectAll" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
        </Grid>
        </TabItem>

        <TabItem Header="前端 (Vue)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 前端工具列 -->
                <materialDesign:Card Grid.Row="0" Margin="8,8,8,4" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding AddFrontendProjectCommand}"
                                ToolTip="加入前端專案">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderPlus" VerticalAlignment="Center" />
                                <TextBlock Text="加入前端專案" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <Grid Grid.Row="1" Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：專案清單（兩固定群組） -->
                    <materialDesign:Card Grid.Column="0" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="內部 (Meso)" Margin="12,10,12,4"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                <ItemsControl ItemsSource="{Binding InternalProjects}"
                                              ItemTemplate="{StaticResource FrontendProjectTemplate}"
                                              Margin="4,0" />
                                <TextBlock Text="外部 (Strato)" Margin="12,10,12,4"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                                <ItemsControl ItemsSource="{Binding ExternalProjects}"
                                              ItemTemplate="{StaticResource FrontendProjectTemplate}"
                                              Margin="4,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" />

                    <!-- 右：log 區（子 Tab 內部/外部） -->
                    <TabControl Grid.Column="2">
                        <TabItem Header="內部 log">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="8,6">
                                    <TextBlock Text="{Binding InternalRunningLabel}"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            Command="{Binding ClearInternalLogCommand}" ToolTip="清除日誌"
                                            Width="28" Height="28" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            Command="{Binding ExportFrontendLogCommand}" CommandParameter="{Binding InternalLog}"
                                            ToolTip="匯出日誌" Width="28" Height="28" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
                                    </Button>
                                    <TextBox DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right"
                                             materialDesign:HintAssist.Hint="過濾關鍵字"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             Text="{Binding InternalLog.Filter, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding InternalLog.View}"
                                         SelectionMode="Extended"
                                         FontFamily="Consolas, Courier New" FontSize="12"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="複製選取行"
                                                      Command="{Binding CopySelectedFrontendLogCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="複製全部日誌"
                                                      Command="{Binding CopyAllFrontendLogCommand}"
                                                      CommandParameter="{Binding InternalLog}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="SelectAll" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="外部 log">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="8,6">
                                    <TextBlock Text="{Binding ExternalRunningLabel}"
                                               VerticalAlignment="Center" FontWeight="Bold" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            Command="{Binding ClearExternalLogCommand}" ToolTip="清除日誌"
                                            Width="28" Height="28" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconForegroundButton}"
                                            Command="{Binding ExportFrontendLogCommand}" CommandParameter="{Binding ExternalLog}"
                                            ToolTip="匯出日誌" Width="28" Height="28" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
                                    </Button>
                                    <TextBox DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right"
                                             materialDesign:HintAssist.Hint="過濾關鍵字"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                             Text="{Binding ExternalLog.Filter, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding ExternalLog.View}"
                                         SelectionMode="Extended"
                                         FontFamily="Consolas, Courier New" FontSize="12"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="複製選取行"
                                                      Command="{Binding CopySelectedFrontendLogCommand}"
                                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="複製全部日誌"
                                                      Command="{Binding CopyAllFrontendLogCommand}"
                                                      CommandParameter="{Binding ExternalLog}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="SelectAll" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </TabItem>
        </TabControl>

        <!-- 狀態列 -->
        <materialDesign:Card Grid.Row="1" Margin="8,4,8,8" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RunningCount, StringFormat='Running: {0}'}" 
                               Margin="4,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="🔴" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StoppedCount, StringFormat='Stopped: {0}'}" 
                               Margin="4,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="📊" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}" 
                               Margin="4,0,16,0" VerticalAlignment="Center" />
                    <Border Background="#1E88E5" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DockerModeLabel}" FontSize="11"
                                   Foreground="White" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="Gray" />
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</Window>
